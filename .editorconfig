root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

# Generated by `dotnet ef`, which always writes a BOM.
[**/Migrations/*.cs]
charset = utf-8-bom

[*.{csproj,json,yml,yaml,slnx,ts,tsx,js,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
